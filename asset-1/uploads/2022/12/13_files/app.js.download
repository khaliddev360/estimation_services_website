ro.png",mediaType:"image"},buttons:[{actionUri:"skype:?action=noop",title:"Yes",backgroundColor:"#00cea6"},{actionUri:"skype:?action=noop",title:"No",backgroundColor:"#ff6767"}]}},{contentType:"application/vnd.microsoft.card.popup",cardType:1,iconUrl:"https://az705183.vo.msecnd.net/dam/skype/media/skype/images/s4l/engcards/test-popcard_icon.png",campaignGuid:"popcard-test",platformList:[1,2],language:"en",validForPeriod:"1.minutes",content:{title:"What do you think",text:"We updated the design to make skype easier to use. Is it working?",media:{url:"https://az705183.vo.msecnd.net/dam/skype/media/skype/images/s4l/engcards/test-popcard_mobile_hero.png",mediaType:"image"},buttons:[{actionUri:"skype:?action=noop",title:"Yes, it's awesome!",backgroundColor:"#00cea6"},{actionUri:"skype:?action=noop",title:"No, I don't like it.",backgroundColor:"#ff6767"}]}},{contentType:"application/vnd.microsoft.card.popup",cardType:1,iconUrl:"https://az705183.vo.msecnd.net/dam/skype/media/skype/images/s4l/engcards/test-popcard_icon.png",campaignGuid:"popcard-test",platformList:[1,2],language:"en",validForPeriod:"1.minutes",content:{title:"What's New in Skype",text:"*Call recording is here for you to capture special life moments or an important meeting at work.\n\n*Introducing end-to-end encrypted calls and chats with Private Conversations.",media:{url:"https://az705183.vo.msecnd.net/dam/skype/media/engagement/whatsnew8.27/eef4bc12-f860-462b-9eab-f609764827d3_nf_star_736x310.gif",mediaType:"image"},buttons:[{actionUri:"skype:?action=noop",title:"Got it!"}]}},{contentType:"application/vnd.microsoft.card.popup",cardType:1,iconUrl:"https://az705183.vo.msecnd.net/dam/skype/media/skype/images/s4l/engcards/test-popcard_icon.png",campaignGuid:"popcard-test",platformList:[1,2],language:"en",validForPeriod:"1.minutes",content:{title:"We're updating our terms",text:"As a part of our effort to improve your experience across our consumer services, we’re updating the Skype Insider Terms of Use.\n\n\n